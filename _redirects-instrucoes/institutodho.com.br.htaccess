# ============================================================
# institutodho.com.br — Redirects 301 para cvatbrasil.com
# Arquivo: .htaccess (colocar na raiz do domínio institutodho.com.br)
# ============================================================

Options -Indexes
RewriteEngine On

# Forçar HTTPS primeiro (se ainda não forçar)
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# ── Páginas específicas mapeadas ─────────────────────────────

# HSE-IT / avaliação psicossocial
RewriteRule ^hse/?$                 https://cvatbrasil.com/pages/treinamentos/hse.html [R=301,L]
RewriteRule ^hse-it/?$              https://cvatbrasil.com/pages/treinamentos/hse.html [R=301,L]
RewriteRule ^avaliacao-psicossocial/?$ https://cvatbrasil.com/pages/treinamentos/hse.html [R=301,L]

# COPSOQ
RewriteRule ^copsoq/?$              https://cvatbrasil.com/pages/treinamentos/copsoq.html [R=301,L]
RewriteRule ^copsoq-iii/?$          https://cvatbrasil.com/pages/treinamentos/copsoq.html [R=301,L]

# Treinamentos / cursos
RewriteRule ^treinamentos/?$        https://cvatbrasil.com/pages/treinamentos.html [R=301,L]
RewriteRule ^cursos/?$              https://cvatbrasil.com/pages/treinamentos.html [R=301,L]
RewriteRule ^curso/?(.*)$           https://cvatbrasil.com/pages/treinamentos.html [R=301,L]

# NR-01 / GRO
RewriteRule ^nr-01/?$               https://cvatbrasil.com/pages/nr01.html [R=301,L]
RewriteRule ^nr01/?$                https://cvatbrasil.com/pages/nr01.html [R=301,L]
RewriteRule ^gro/?$                 https://cvatbrasil.com/pages/nr01.html [R=301,L]

# Gestor NR-01
RewriteRule ^gestor-nr01/?$         https://cvatbrasil.com/pages/treinamentos/gestornr01.html [R=301,L]
RewriteRule ^gestor/?$              https://cvatbrasil.com/pages/treinamentos/gestornr01.html [R=301,L]

# Blog / artigos
RewriteRule ^blog/?$                https://cvatbrasil.com/pages/blog/ [R=301,L]
RewriteRule ^blog/(.+)/?$           https://cvatbrasil.com/pages/blog/$1 [R=301,L]
RewriteRule ^artigo/(.+)/?$         https://cvatbrasil.com/pages/blog/$1 [R=301,L]

# Contato / sobre / home
RewriteRule ^contato/?$             https://cvatbrasil.com/pages/contato.html [R=301,L]
RewriteRule ^sobre/?$               https://cvatbrasil.com/pages/sobre.html [R=301,L]
RewriteRule ^diagnostico/?$         https://cvatbrasil.com/pages/diagnostico.html [R=301,L]

# ── Qualquer outra URL → home ────────────────────────────────
RewriteRule ^(.*)$                  https://cvatbrasil.com/ [R=301,L]
